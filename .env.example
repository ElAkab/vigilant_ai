# ── Vigilant AI — Variables d'environnement ──
# Copiez ce fichier en .env.development ou .env.production selon l'environnement.
# Ne commitez JAMAIS de fichier .env* contenant des secrets réels.

# ── Obligatoire ──────────────────────────────────────────────
# Clé API OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-...

# ── Environnement ────────────────────────────────────────────
# development → .env.development (dev local, port 8788)
# production  → .env.production  (Vercel, port 8787)
APP_ENV=development

# ── Serveur ──────────────────────────────────────────────────
# Port d'écoute (défaut : 8787)
PORT=8787

# Dossier des fichiers statiques (défaut : dist)
# STATIC_DIR=dist

# ── Base de données ──────────────────────────────────────────
# Chemin SQLite. Séparer dev et prod :
#   dev:  server/data/articles_dev.db
#   prod: server/data/articles.db
DB_PATH=server/data/articles.db

# ── IA / OpenRouter ──────────────────────────────────────────
# Modèle prioritaire (optionnel). Si non défini, tous les modèles
# gratuits sont essayés en round-robin. Exemples :
#   openrouter/free
#   meta-llama/llama-3.3-70b-instruct:free
#   google/gemma-4-31b-it:free
# OPENROUTER_MODEL=openrouter/free

# Mode mock pour les tests (défaut : false)
# MOCK_AI=false
