## Backend (Bun)

# Required: OpenRouter API key for accessing free LLM models
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: Override the default model selection
# If set, this model will be tried first before falling back to default models:
# - llama-3.1-8b (Meta Llama 3.1 8B Instruct, free)
# - mixtral-8x7b (Mistral Mixtral 8x7B Instruct, free)
# - qwen-72b (Qwen 72B Chat, free)
OPENROUTER_MODEL=llama-3.1-8b

# Optional: Override default OpenRouter API endpoint
# OPENROUTER_URL=https://api.openrouter.ai/v1

# Optional: API port (default: 8787)
# PORT=8787

# Optional: Enable mock AI responses for development/testing
# MOCK_AI=false

# Optional: Context7 API key for dynamic model configuration
# CONTEXT7_API_KEY=your_context7_api_key_here